# Copy to .env and fill in. NEVER commit .env.
# OpenAI:
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
# Ollama (local):  OPENAI_API_KEY=ollama  OPENAI_BASE_URL=http://localhost:11434/v1  MODEL=llama3.1
# LM Studio:       OPENAI_API_KEY=lm-studio OPENAI_BASE_URL=http://localhost:1234/v1  MODEL=<loaded model id>
# Optional: price per 1K tokens for cost metrics of the real run (USD)
PRICE_PER_1K_PROMPT=0.00015
PRICE_PER_1K_COMPLETION=0.0006
